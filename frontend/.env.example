# PayPilot AI Frontend Environment Configuration

# Backend API endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Pure Live Mode Switch
# - Set to 'true' to include visual blueprint seeded records (ideal for UI visual matching)
# - Set to 'false' for 100% PURE LIVE DATA ONLY (no seed/mock records; only live MySQL & PayPal data)
NEXT_PUBLIC_ENABLE_SEED_DATA=true
